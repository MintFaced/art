{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/derive-assets.js": {
      "maxDuration": 300,
      "memory": 3008
    },
    "api/warm-assets.js": {
      "maxDuration": 300,
      "memory": 3008
    },
    "api/cron/listings.js": {
      "maxDuration": 300
    },
    "api/cron/owners.js": {
      "maxDuration": 300
    },
    "api/cron/tao.js": {
      "maxDuration": 300
    },
    "api/og.js": {
      "includeFiles": "api/_fonts/**",
      "memory": 1024
    },
    "api/cron/nudges.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/chat",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tao",
      "destination": "https://collectors.mintface.art/#tao",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/tao/runs",
      "destination": "/data/tao/runs.json"
    },
    {
      "source": "/s/:key",
      "destination": "/api/studio"
    },
    {
      "source": "/w/:id",
      "destination": "/api/w"
    },
    {
      "source": "/c/frogdna",
      "destination": "/f"
    },
    {
      "source": "/c/patrimora",
      "destination": "/patrimora"
    },
    {
      "source": "/recent",
      "destination": "/c"
    },
    {
      "source": "/c/:slug",
      "destination": "/api/c"
    },
    {
      "source": "/genesis",
      "destination": "/f"
    },
    {
      "source": "/10k",
      "destination": "/f"
    },
    {
      "source": "/frogdna",
      "destination": "/f"
    },
    {
      "source": "/set/:slug",
      "destination": "/set"
    },
    {
      "source": "/:key",
      "destination": "/api/studio"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reserves",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/listings",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/owners",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/tao",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/nudges",
      "schedule": "0 22 * * *"
    }
  ],
  "headers": [
    {
      "source": "/data/(availability|tao/totals).json",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=0, s-maxage=600, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
