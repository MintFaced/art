{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/w/:id",
      "destination": "/w.html"
    },
    {
      "source": "/c/:slug",
      "destination": "/c.html"
    },
    {
      "source": "/genesis",
      "destination": "/f.html"
    },
    {
      "source": "/10k",
      "destination": "/f.html"
    }
  ]
}
