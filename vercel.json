{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/derive-assets.js": {
      "maxDuration": 300,
      "memory": 3008
    },
    "api/warm-assets.js": {
      "maxDuration": 300
    },
    "api/cron/listings.js": {
      "maxDuration": 300
    },
    "api/cron/owners.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/s/:key",
      "destination": "/api/studio"
    },
    {
      "source": "/w/:id",
      "destination": "/api/w"
    },
    {
      "source": "/c/frogdna",
      "destination": "/f"
    },
    {
      "source": "/c/patrimora",
      "destination": "/patrimora"
    },
    {
      "source": "/recent",
      "destination": "/c"
    },
    {
      "source": "/c/:slug",
      "destination": "/c"
    },
    {
      "source": "/genesis",
      "destination": "/f"
    },
    {
      "source": "/10k",
      "destination": "/f"
    },
    {
      "source": "/frogdna",
      "destination": "/f"
    },
    {
      "source": "/set/:slug",
      "destination": "/set"
    },
    {
      "source": "/:key",
      "destination": "/api/studio"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reserves",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/listings",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/owners",
      "schedule": "0 21 * * *"
    }
  ]
}
